{% extends 'public.html.twig' %}
{% block title %}Mes groupes{% endblock %}
{% block body %}
    <div class="sjdb-home"><div class="sjdb-bg"></div><main class="sjdb-card sjdb-card--wide">
            <header class="sjdb-header"><div class="sjdb-brand">
                    <div class="sjdb-domain">Mes conversations de groupe</div>
                    <div class="sjdb-tagline">Choisissez un groupe pour retrouver la discussion instantanée.</div>
                    </div>
                {% if is_granted('ROLE_ADMIN') %}
                    <div class="sjdb-actions"><a class="sjdb-pill" href="{{ path('team_conversation_create') }}">Créer un groupe</a></div>
                {% endif %}</header>
            <section class="sjdb-content team-list">
                {% for membership in memberships %}
                    <a class="team-card" href="{{ path('team_conversation_show', {id: membership.team.id}) }}"><strong>{{ membership.team.name }}</strong><span>{% if membership.team.escapeGame %}{{ membership.team.escapeGame.name }} · {% else %}Conversation indépendante · {% endif %}rejoint le {{ membership.joinedAt|date('d/m/Y') }}</span></a>
                {% else %}<p class="sjdb-lead">Aucun groupe pour le moment. Ouvrez le lien reçu par email pour rejoindre une conversation.</p>{% endfor %}
            </section>
            <footer class="sjdb-footer"><a class="sjdb-pill" href="{{ path('app_profile') }}">Mon profil</a>{% if is_granted('ROLE_AGENT') %}<a class="sjdb-btn" href="{{ path('information_sheet_workspace_index') }}">Mon espace fiches</a>{% endif %}<a class="sjdb-pill" href="{{ path('app_logout') }}">Déconnexion</a></footer>
        </main></div>
{% endblock %}
