{% extends 'public.html.twig' %}
{% block title %}{{ page.title }} · Manuel SI{% endblock %}
{% block body %}
    {% set type_partials = {
        'page': 'public/manual/_type_page.html.twig',
        'procedure': 'public/manual/_type_procedure.html.twig',
        'memo': 'public/manual/_type_memo.html.twig',
        'checklist': 'public/manual/_type_checklist.html.twig',
        'referentiel': 'public/manual/_type_referentiel.html.twig',
        'naming-rule': 'public/manual/_type_naming_rule.html.twig',
        'equipment-sheet': 'public/manual/_type_equipment_sheet.html.twig'
    } %}
    {% set page_type = page.type|default('page') %}
    <div class="sjdb-home manual-page">
        <div class="sjdb-bg"></div>
        <main class="sjdb-card sjdb-card--wide" role="main">
            <header class="sjdb-header">
                <div class="sjdb-brand">
                    <div class="sjdb-domain">{{ page.title }}</div>
                    <div class="sjdb-tagline"><a
                                href="{{ path('manual_public_section', { sectionSlug: section.slug }) }}">{{ section.title }}</a>{% if page.publishedAt %} · publié le {{ page.publishedAt|date('d/m/Y') }}{% endif %}
                    </div>
                </div>{{ include('public/manual/_page_type_badge.html.twig') }}</header>
            <div class="manual-layout">{{ include('public/manual/_sidebar.html.twig') }}
                <article
                        class="sjdb-content manual-main manual-detail manual-detail--{{ page_type|replace({'_': '-', ' ': '-'}) }}">
                    {% if page.summary and page_type not in ['memo', 'equipment-sheet'] %}<p
                            class="manual-lead">{{ page.summary }}</p>{% endif %}
                    {% include type_partials[page_type]|default(type_partials.page) with { page: page } only %}
                    {% if page.tags %}
                        <div class="sjdb-actions manual-tags">{% for tag in page.tags %}<span class="sjdb-pill">
                        #{{ tag }}</span>{% endfor %}</div>{% endif %}
                </article>
            </div>
            <footer class="sjdb-footer"><a class="sjdb-btn"
                                           href="{{ path('manual_public_section', { sectionSlug: section.slug }) }}">Retour
                    à la rubrique</a></footer>
        </main>
    </div>
{% endblock %}