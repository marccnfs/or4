{% extends 'public.html.twig' %}

{% block title %}sjdb.space{% endblock %}

{% block body %}
    <div class="sjdb-home">
    <div class="sjdb-bg"></div>

    <main class="sjdb-card" role="main" aria-label="Accueil sjdb.space">
    <header class="sjdb-header">
        <img
                class="sjdb-logo"
                src="{{ asset('images/logo_sjdb_lite.png') }}"
                alt="Logo sjdb.space"
                width="160"
                height="160"
                loading="eager"
        />

        <div class="sjdb-brand">
            <div class="sjdb-domain">sjdb.space</div>
            <div class="sjdb-tagline">by RSI</div>
        </div>
    </header>

    <section class="sjdb-content">
                <h1 class="sjdb-title">Le Guide Numérique de Saint-Jean-de-Boiseau<span class="sjdb-muted"></span></h1>

                <p class="sjdb-lead">
                    Un espace simple pour comprendre, utiliser et mieux vivre les outils numériques de la collectivité
                </p>

                <nav class="sheet-home-menu" aria-label="Rubriques des fiches d'information">
                    <a class="sheet-home-link" href="{{ path('information_sheet_index', { category: 'comprendre' }) }}">Comprendre</a>
                    <a class="sheet-home-link" href="{{ path('information_sheet_index', { category: 'je-veux' }) }}">Je veux...</a>
                    <a class="sheet-home-link" href="{{ path('information_sheet_index', { category: 'bonnes-pratiques' }) }}">Bonnes pratiques</a>
                    <a class="sheet-home-link" href="{{ path('information_sheet_index', { category: 'faq' }) }}">FAQ</a>
                </nav>

                <ul class="sjdb-bullets">
                    <li>🧠 Agents IA et assistants métier</li>
                    <li>🧩 Approches ludiques</li>
                    <li>🛠️ Sécurité et usage de l'IA</li>
                    <li>📚 Info “terrain”</li>
                </ul>

            </section>

            <footer class="sjdb-footer">
                <div class="sjdb-actions">
                    <a class="sjdb-btn" href="{{ path('app_login') }}">
                        Se connecter
                        <span class="sjdb-btn-arrow" aria-hidden="true">→</span>
                    </a>
                    <a class="sjdb-btn" href="{{ path('information_sheet_index') }}">
                        Consulter les fiches
                        <span class="sjdb-btn-arrow" aria-hidden="true">→</span>
                    </a>
                    {#
                    <a class="sjdb-btn" href="/ia/chat">
                        Lancer le chatbot & animations
                        <span class="sjdb-btn-arrow" aria-hidden="true">→</span>
                    </a>
                    #}
                </div>

                <div class="sjdb-meta">
                    <span class="sjdb-pill">Travail collaboratif mode d'emploi</span>
                    <span class="sjdb-pill">pour qui ?</span>
                    <span class="sjdb-pill">à suivre</span>
                </div>
            </footer>
        </main>
    </div>

{% endblock %}