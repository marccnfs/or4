{% extends 'public.html.twig' %}

{% block title %}{{ sheet.title }}{% endblock %}

{% block body %}
    <div class="sjdb-home sheet-page sheet-page--mobile">
        <div class="sjdb-bg"></div>
        <main class="sjdb-card" role="main" aria-label="{{ sheet.title }}">
            <article class="sjdb-content sheet-detail sheet-detail--mobile">
                <a class="sjdb-pill" href="{{ path('information_sheet_index', { category: sheet.category }) }}">{{ sheet.categoryLabel }}</a>
                <h1 class="sjdb-title">{{ sheet.title }}</h1>
                {% if sheet.subtitle %}<p class="sjdb-lead">{{ sheet.subtitle }}</p>{% endif %}
                {% if sheet.imagePath %}<img class="sheet-hero" src="{{ asset(sheet.imagePath) }}" alt="{{ sheet.imageAlt ?? sheet.title }}">{% endif %}
                <div class="sheet-markdown">{{ sheet.contentMarkdown|markdown_to_html }}</div>
                <div class="sjdb-actions sheet-workspace-actions">
                    {% if app.user %}
                        <form method="post" action="{{ path('information_sheet_workspace_create', { slug: sheet.slug }) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('create_workspace_' ~ sheet.id) }}">
                            <button class="sjdb-btn" type="submit">Créer mon dossier de travail</button>
                        </form>
                        <a class="sjdb-pill" href="{{ path('information_sheet_workspace_index') }}">Mon espace fiches</a>
                    {% else %}
                        <a class="sjdb-btn" href="{{ path('agent_register') }}">Créer un compte agent</a>
                        <a class="sjdb-pill" href="{{ path('app_login') }}">Se connecter pour créer un dossier</a>
                    {% endif %}
                </div>
            </article>

            <footer class="sjdb-footer">
                <a class="sjdb-btn" href="{{ path('information_sheet_index') }}">Retour aux fiches</a>
            </footer>
        </main>
    </div>
{% endblock %}
