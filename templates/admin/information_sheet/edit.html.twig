{% extends 'admin_base.html.twig' %}

{% block title %}Éditer une fiche{% endblock %}

{% block body %}
    <div class="pilot-page">
        <h1>Éditer « {{ sheet.title }} »</h1>
        {% include 'admin/information_sheet/_form.html.twig' with { form: form, sheet: sheet, button_label: 'Enregistrer' } %}
        <div class="sjdb-actions">
            <a class="sjdb-pill" href="{{ path('admin_information_sheet_show', { id: sheet.id }) }}">Retour</a>
            <a class="sjdb-pill" href="{{ path('admin_information_sheet_list') }}">Liste des fiches</a>
        </div>
    </div>
{% endblock %}
